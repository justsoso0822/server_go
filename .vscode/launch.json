{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch server_gin",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "cwd": "${workspaceFolder}",
      "env": {
        "GO111MODULE": "on"
      }
    },
    {
      "name": "Launch deploy tool",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/deploy/main.go",
      "cwd": "${workspaceFolder}",
      "env": {
        "GO111MODULE": "on"
      },
      "args": [
        "deploy",
        "local"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug scratch main",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/scratch/main.go",
      "cwd": "${workspaceFolder}",
      "env": {
        "GO111MODULE": "on"
      }
    }
  ]
}